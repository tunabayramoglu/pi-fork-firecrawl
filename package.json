{
	"name": "@tuna-bayramoglu/pi-firecrawl-multikey",
	"version": "1.0.0",
	"description": "Pi extension that exposes Firecrawl web scraping and crawling tools with multi-key rotation and quota-aware fallback.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"firecrawl",
		"scrape",
		"crawl",
		"multi-key",
		"quota",
		"rotation"
	],
	"files": [
		"src",
		"test",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check . && npm run typecheck",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test test/*.test.ts"
	},
	"dependencies": {
		"sqlite-vec": "^0.1.9",
		"typebox": "^1.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-coding-agent": "0.82.0",
		"tsx": "^4.0.0",
		"typescript": "7.0.2"
	}
}
